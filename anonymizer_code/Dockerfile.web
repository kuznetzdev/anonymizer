FROM node:22-alpine AS build
WORKDIR /web
COPY anonymizer_code/frontend/package*.json ./
RUN npm ci
COPY anonymizer_code/frontend/ ./
RUN npm run build

FROM nginx:1.30.5-alpine3.24
COPY anonymizer_code/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /web/dist /usr/share/nginx/html
EXPOSE 8080
